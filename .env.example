# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/cybertrap_db
DATABASE_ECHO=False

# Security
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=2592000

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@cybertrap.ai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Honeypot Configuration
HONEYPOT_SSH_PORT=2222
HONEYPOT_HTTP_PORT=8080
HONEYPOT_FTP_PORT=2121
HONEYPOT_TELNET_PORT=2323
HONEYPOT_LOG_PATH=/var/log/honeypot/
HONEYPOT_DATA_PATH=/data/honeypot/

# AWS Configuration (Optional)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
S3_BUCKET=cybertrap-backups

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Pagination
ITEMS_PER_PAGE=20

# 2FA
2FA_ENABLED=True
TOTP_ISSUER=CyberTrap-AI

# API Keys
API_RATE_LIMIT=100
API_RATE_LIMIT_PERIOD=3600

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Features
FEATURE_ANALYTICS=True
FEATURE_NOTIFICATIONS=True
FEATURE_BACKUP=True
FEATURE_AUDIT_LOG=True
