# Build environment
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybertrap_db
DB_USER=cybertrap
DB_PASSWORD=cybertrap123
DATABASE_URL=postgresql://cybertrap:cybertrap123@localhost:5432/cybertrap_db

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=2592000

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@cybertrap.ai

# Security
2FA_ENABLED=True
TOTP_ISSUER=CyberTrap-AI

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Honeypot Configuration
HONEYPOT_SSH_PORT=2222
HONEYPOT_HTTP_PORT=8080
HONEYPOT_FTP_PORT=2121
HONEYPOT_TELNET_PORT=2323
HONEYPOT_LOG_PATH=/var/log/honeypot/
HONEYPOT_DATA_PATH=/data/honeypot/

# AWS (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
